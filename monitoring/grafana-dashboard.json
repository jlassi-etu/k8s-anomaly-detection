{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Sélectionnez votre datasource Prometheus (kube-prometheus-stack) lors de l'import",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "K8s Anomaly Detection - Cluster & Workload",
  "description": "Suivi CPU/mémoire/réseau du cluster Kind et des pods du namespace workload, pour corréler avec les injections Chaos Mesh (cpu_spike, memory_leak, resource_saturation, network_anomaly, abnormal_drop).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["k8s-anomaly-detection", "kind", "chaos-mesh"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Vue cluster (nœuds)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU moyen par nœud (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mémoire utilisée par nœud (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Trafic réseau par nœud (réception / émission)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[1m]))",
          "legendFormat": "{{instance}} - reçu",
          "refId": "A"
        },
        {
          "expr": "sum by(instance) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[1m]))",
          "legendFormat": "{{instance}} - émis",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Erreurs réseau par nœud",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(node_network_receive_errs_total[1m]) + rate(node_network_transmit_errs_total[1m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Workload cible (namespace workload)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pods Ready",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "green", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"workload\", condition=\"true\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Redémarrages (5 dernières min)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"workload\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "CPU total workload (cores)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"workload\", container!=\"\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Mémoire totale workload",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 800000000 },
              { "color": "red", "value": 1500000000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"workload\", container!=\"\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU par pod (workload)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(pod) (rate(container_cpu_usage_seconds_total{namespace=\"workload\", container!=\"\"}[1m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mémoire par pod (workload)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(pod) (container_memory_working_set_bytes{namespace=\"workload\", container!=\"\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redémarrages de pods par pod (fenêtre 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(pod) (increase(kube_pod_container_status_restarts_total{namespace=\"workload\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pods Ready dans le temps",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"workload\", condition=\"true\"})",
          "legendFormat": "pods ready",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Intelligence Artificielle (temps réel - ai_inference_exporter.py)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Anomalie détectée actuellement ?",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NORMAL", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "ANOMALIE", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        { "expr": "k8s_ai_cluster_is_anomaly", "refId": "A" }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Type d'anomalie détecté (probabilités par type)",
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "align": "center" } },
        "overrides": []
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ],
      "targets": [
        {
          "expr": "k8s_ai_anomaly_type_probability",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "state-timeline",
      "title": "Historique du type d'anomalie détecté par l'IA",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 70 }
        },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "displayName", "value": "cpu_spike" }] }
        ]
      },
      "options": { "mergeValues": true, "showValue": "never" },
      "targets": [
        { "expr": "k8s_ai_anomaly_type_active{type=\"cpu_spike\"}", "legendFormat": "cpu_spike", "refId": "A" },
        { "expr": "k8s_ai_anomaly_type_active{type=\"memory_leak\"}", "legendFormat": "memory_leak", "refId": "B" },
        { "expr": "k8s_ai_anomaly_type_active{type=\"resource_saturation\"}", "legendFormat": "resource_saturation", "refId": "C" },
        { "expr": "k8s_ai_anomaly_type_active{type=\"network_anomaly\"}", "legendFormat": "network_anomaly", "refId": "D" },
        { "expr": "k8s_ai_anomaly_type_active{type=\"abnormal_drop\"}", "legendFormat": "abnormal_drop", "refId": "E" }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Score Isolation Forest (temps réel, pire pod du cluster)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "k8s_ai_cluster_anomaly_score", "legendFormat": "score (bas = anormal)", "refId": "A" }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Charge CPU prédite par le Random Forest vs CPU réel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 },
        "overrides": []
      },
      "targets": [
        { "expr": "k8s_ai_predicted_cpu_percent", "legendFormat": "CPU prédit (horizon training)", "refId": "A" },
        {
          "expr": "100 - (avg (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU réel actuel",
          "refId": "B"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Remédiation automatique (remediation_controller.py)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Approbation en attente (mode semi-auto)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Aucune", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "EN ATTENTE", "color": "orange" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        { "expr": "k8s_remediation_pending_approval", "refId": "A" }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Dernière action corrective",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        { "expr": "k8s_remediation_last_action_timestamp * 1000", "refId": "A" }
      ]
    },
    {
      "id": 32,
      "type": "table",
      "title": "Historique des actions par type et statut",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ],
      "targets": [
        {
          "expr": "k8s_remediation_actions_total",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Fréquence des actions correctives dans le temps",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(type, action) (increase(k8s_remediation_actions_total[5m]))",
          "legendFormat": "{{type}} - {{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Nombre de pods sample-workload (désiré vs disponible) — effet du scaling",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 69 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"workload\", deployment=\"sample-workload\"}",
          "legendFormat": "désiré (cible du scaling)",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"workload\", deployment=\"sample-workload\"}",
          "legendFormat": "disponible (réellement Running)",
          "refId": "B"
        }
      ]
    }
  ]
}
